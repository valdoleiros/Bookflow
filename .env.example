# ============================================================
# BookFlow – variáveis de ambiente necessárias
# Copia este ficheiro para .env.local e preenche os valores.
# NUNCA cometes .env.local – está no .gitignore.
# ============================================================

# --- Supabase (obrigatório) ---
# Desenvolvimento local: valores gerados por `supabase start`
# Produção: obtidos em app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App URL (obrigatório) ---
# Dev: http://localhost:3000
# Produção: https://o-teu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (obrigatório em produção) ---
# Gerar com: openssl rand -base64 32
# Configura no Vercel como Bearer token nos headers do Cron Job
CRON_SECRET=substitui-por-valor-forte-gerado-com-openssl

# --- Email via Resend (opcional em dev, obrigatório em produção) ---
# Conta em resend.com – plano gratuito cobre 3000 emails/mês
# Em dev: deixa vazio ou usa "mock" – as notificações vão para o console
RESEND_API_KEY=re_xxxxxxxxx
FROM_EMAIL=noreply@o-teu-dominio.com

# --- SMS via Twilio (opcional em dev, obrigatório em produção) ---
# Conta em twilio.com – trial gratuito com ~€15 de crédito
# Em dev: deixa vazio – os SMS vão para o console (mock automático)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+351XXXXXXXXX

# --- Stripe (obrigatório em produção) ---
# Conta em dashboard.stripe.com
# Secret key: Developers → API keys
# Price ID: Products → criar produto/plano → copiar ID do preço (price_xxx)
# Webhook secret: Developers → Webhooks → adicionar endpoint → copiar signing secret
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
